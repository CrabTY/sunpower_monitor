{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["shared/**/*.ts", "ingest/src/**/*.ts", "ingest/test/**/*.ts", "dashboard/src/**/*.ts", "dashboard/test/**/*.ts"]
}
