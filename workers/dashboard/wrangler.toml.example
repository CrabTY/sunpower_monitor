# Rendered to wrangler.toml by scripts/render-config.mjs (untracked).
name = "{{DASHBOARD_WORKER_NAME}}"
main = "src/index.ts"
compatibility_date = "2025-10-01"
workers_dev = true

# Optional custom domain. Without DASHBOARD_HOST, workers.dev is the only route.
# Keep this above every [section] so TOML treats it as a top-level key.
{{DASHBOARD_ROUTE}}

[[d1_databases]]
binding = "DB"
database_name = "{{D1_DATABASE_NAME}}"
database_id = "{{D1_DATABASE_ID}}"

[assets]
directory = "../../web"
binding = "ASSETS"
# Every request goes through the worker, so assets and APIs share one login gate.
run_worker_first = true

[vars]
ALLOWED_USER_IDS = "{{ALLOWED_USER_IDS}}"
COLLECTOR_ID = "{{COLLECTOR_ID}}"
DEPLOY_TAG = "{{DEPLOY_TAG}}"
GIT_SHA = "{{GIT_SHA}}"

# Secrets are set outside the repository, never here:
#   npx wrangler secret put GITHUB_CLIENT_ID
#   npx wrangler secret put GITHUB_CLIENT_SECRET
#   npx wrangler secret put SESSION_SECRET
