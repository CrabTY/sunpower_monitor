# Copy to .env (untracked) and fill in. Deployment values stay out of Git.
# Secrets are NOT listed here: they live only in Worker secrets or Actions secrets.

# Cloudflare account identifier, D1 database UUID, and database name.
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
D1_DATABASE_NAME=sunpower-monitor

# Anonymous collector name shared by the Pi and both Workers.
COLLECTOR_ID=home-pvs

# Worker names become the first part of their workers.dev addresses.
DASHBOARD_WORKER_NAME=sunpower-monitor-dashboard
INGEST_WORKER_NAME=sunpower-monitor-ingest

# Numeric GitHub user IDs allowed to read the dashboard.
ALLOWED_USER_IDS=

# Deployment metadata embedded in /api/v1/version.
DEPLOY_TAG=dev
GIT_SHA=unknown

# Optional dashboard hostname. Leave blank to use the free workers.dev address.
DASHBOARD_HOST=

# Set in CI or as Worker secrets, never in this file:
#   CLOUDFLARE_API_TOKEN      Actions secret used to deploy
#   UPLOAD_TOKEN              ingest Worker secret, also on the Pi
#   GITHUB_CLIENT_ID/SECRET   dashboard Worker secrets
#   SESSION_SECRET            dashboard Worker secret
