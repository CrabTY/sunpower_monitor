# Copy to /etc/sunpower-monitor/collector.env (root:sunpower, mode 0640).
# Never commit the filled-in file or the token it points at.

# PVS6 LAN address. The collector never exposes it and never accepts inbound traffic.
PVS_HOST=192.0.2.10

# Stable anonymous collector name; it becomes part of every record ID.
COLLECTOR_ID=home-pvs

# Ingest Worker origin. The Pi never needs the dashboard URL.
INGEST_BASE_URL=https://sunpower-monitor-ingest.example.workers.dev

# File holding the upload token (mode 0600, owned by the collector user).
INGEST_TOKEN_FILE=/etc/sunpower-monitor/upload-token
